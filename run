#!/usr/bin/env bash
#
# usage: ./run command [argument ...]
#
# Commands for kibends development.
#

set -o nounset
set -o pipefail
set -o errexit

# Change the current directory to the project root.
PROJECT_ROOT=${0%/*}
if [[ $0 != $PROJECT_ROOT && $PROJECT_ROOT != "" ]]; then
  cd "$PROJECT_ROOT"
fi
readonly PROJECT_ROOT=$(pwd)

# pyo3's build scripts configure themselves from this interpreter. The
# editable build uses the same one, so cargo and `uv sync` share one build of
# pyo3 instead of each rebuilding it after the other.
export PYO3_PYTHON="$PROJECT_ROOT/.venv/bin/python"

################################################################################
# Development Commands

function sync {
  #@ Create or update the virtualenv with dev dependencies and the plot extra, building kibends._core
  #@ Category: Development
  uv sync --extra plot "$@"
}

# On Linux, numpy's OpenBLAS starts a thread per core in every xdist worker,
# and the workers' threads oversubscribe the cores: the suite ran about 10x slower on 4 cores.
# kibends._core's rayon pool would do the same, so each worker keeps one thread.

# The tests run after a quiet sync, which rebuilds kibends._core if its
# sources changed, so they always test the current Rust code.

function test {
  #@ Run the Rust core's tests and the fast Python tests (extra arguments go to pytest)
  #@ Category: Development
  sync --quiet
  cargo test --quiet -p kibends-core
  OPENBLAS_NUM_THREADS=1 RAYON_NUM_THREADS=1 .venv/bin/python -m pytest -m "not slow" "$@"
}

function test-all {
  #@ Run every test, including slow ones
  #@ Category: Development
  sync --quiet
  cargo test --quiet -p kibends-core
  OPENBLAS_NUM_THREADS=1 RAYON_NUM_THREADS=1 .venv/bin/python -m pytest "$@"
}

function bench {
  #@ Measure the optimizer on stitched planes, the scenarios, buses, a lone track beside a cluster and return vias (see scripts/benchmark.py)
  #@ Category: Development
  OPENBLAS_NUM_THREADS=1 .venv/bin/python scripts/benchmark.py "$@"
}

function lint {
  #@ Check linting and formatting with ruff, rustfmt and clippy
  #@ Category: Development
  .venv/bin/ruff check .
  .venv/bin/ruff format --check .
  cargo fmt --all --check
  cargo clippy --quiet --workspace --all-targets -- -D warnings
}

function format {
  #@ Format the code and apply ruff's safe lint fixes
  #@ Category: Development
  .venv/bin/ruff check --fix .
  .venv/bin/ruff format .
  cargo fmt --all
}

readonly STUBS=src/kibends/_core

function stubs {
  #@ Regenerate the type stubs of kibends._core from the Rust sources
  #@ Category: Development
  # The generator links libpython, which on Linux lies outside the
  # loader's search path.
  local libdir
  libdir=$(.venv/bin/python -c 'import sysconfig; print(sysconfig.get_config_var("LIBDIR"))')
  LD_LIBRARY_PATH="$libdir${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
    cargo run --quiet -p kibends-py --bin stub_gen
}

function typecheck {
  #@ Check that the stubs of kibends._core are current, and type-check with pyright in strict mode
  #@ Category: Development
  local committed
  committed=$(mktemp -d)
  cp -R "$STUBS/." "$committed"
  stubs
  if ! diff -r "$committed" "$STUBS"; then
    rm -rf "$committed"
    echo "The stubs in $STUBS were out of date and have been regenerated." >&2
    return 1
  fi
  rm -rf "$committed"
  .venv/bin/pyright
}

function check {
  #@ Run lint, typecheck and every test, as CI does (before committing)
  #@ Category: Development
  lint
  typecheck
  test-all
}

################################################################################
# Help System

function help {
  #@ Show this help message
  #@ Category: Core
  echo "kibends - Development Commands"
  echo "=============================="
  echo ""
  echo "Available commands:"
  echo ""

  # Extract function definitions and their help comments
  awk '/^function / {
    fname = $2
    sub(/[({].*/, "", fname)
    getline
    if ($0 ~ /#@/) {
      desc = $0
      sub(/.*#@ /, "", desc)
      sub(/ *$/, "", desc)
      getline
      if ($0 ~ /#@ Category:/) {
        cat = $0
        sub(/.*Category: /, "", cat)
        sub(/ *$/, "", cat)
        if (!seen[cat]++) categories[++cat_count] = cat
        commands[cat, ++cmd_count[cat]] = fname
        descriptions[cat, cmd_count[cat]] = desc
      }
    }
  }
  END {
    for (i = 1; i <= cat_count; i++) {
      cat = categories[i]
      print "\n" cat ":"
      for (j = 1; j <= cmd_count[cat]; j++) {
        printf "  %-25s %s\n", commands[cat, j], descriptions[cat, j]
      }
    }
  }' "$0"

  echo ""
  echo "Usage: ./run <command> [arguments...]"
  echo ""
}

################################################################################
# Commands end.

TIMEFORMAT=$'\nTask completed in %3lR'
time "${@:-help}"
